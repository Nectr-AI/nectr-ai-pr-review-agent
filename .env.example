# App
APP_NAME=DevCopilot
APP_ENV=development
DEBUG=True
LOG_LEVEL=DEBUG

# Server
HOST=0.0.0.0
PORT=8000

# Database (Supabase PostgreSQL)
# Use the Session Mode pooler URL from Supabase Dashboard → Connect → Connection Pooling
# Format: postgresql+asyncpg://postgres.<project-id>:<password>@aws-0-<region>.pooler.supabase.com:5432/postgres
# Note: Use port 5432 for Session Mode (supports prepared statements)
#       Use port 6543 for Transaction Mode (requires statement_cache_size=0, already handled)
DATABASE_URL=postgresql+asyncpg://postgres.<project-id>:<password>@aws-0-<region>.pooler.supabase.com:5432/postgres

# Anthropic
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-4-5-20250929

# GitHub
GITHUB_PAT=
GITHUB_WEBHOOK_SECRET=
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=

# Mem0 (optional - memory layer for AI context)
MEM0_API_KEY=

# Metorial MCP
METORIAL_API_KEY=
GITHUB_MCP_DEPLOYMENT_ID=

# Slack (optional)
SLACK_BOT_TOKEN=
SLACK_SIGNING_SECRET=

# JWT Auth
SECRET_KEY=your-secret-key
ACCESS_TOKEN_EXPIRE_MINUTES=1440
ALGORITHM=HS256

# URLs
FRONTEND_URL=http://localhost:5173
BACKEND_URL=http://localhost:8000

# GitHub App (for bot identity on PR review comments)
# Create at: https://github.com/settings/apps/new
GITHUB_APP_ID=
GITHUB_APP_PRIVATE_KEY="-----BEGIN RSA PRIVATE KEY-----
...
-----END RSA PRIVATE KEY-----"
