# ─────────────────────────────────────────────
#  Nectr — AI PR Review Agent
#  Copy this file to .env and fill in your keys
# ─────────────────────────────────────────────

# App
APP_NAME=Nectr
APP_ENV=development          # development | production
DEBUG=True
LOG_LEVEL=DEBUG

# Server
HOST=0.0.0.0
PORT=8000

# ── Database ───────────────────────────────────
# Supabase PostgreSQL (recommended) or any PostgreSQL instance
# Supabase: use Session Mode pooler URL (port 5432)
# Format: postgresql+asyncpg://postgres.<project-id>:<password>@aws-0-<region>.pooler.supabase.com:5432/postgres
DATABASE_URL=postgresql+asyncpg://postgres.<project-id>:<password>@aws-0-<region>.pooler.supabase.com:5432/postgres

# ── AI ─────────────────────────────────────────
ANTHROPIC_API_KEY=sk-ant-...
ANTHROPIC_MODEL=claude-sonnet-4-5-20250929

# ── GitHub ─────────────────────────────────────
# OAuth App — create at https://github.com/settings/developers
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=

# Personal Access Token — used to post PR review comments
# Needs repo scope (or public_repo for public repos)
# Create at https://github.com/settings/tokens
GITHUB_PAT=ghp_...

# Optional: global fallback webhook secret (per-repo secrets are stored in DB)
GITHUB_WEBHOOK_SECRET=

# ── JWT Auth ────────────────────────────────────
# Generate a secure random key: python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=your-secret-key-change-this-in-production
ACCESS_TOKEN_EXPIRE_MINUTES=1440
ALGORITHM=HS256

# ── URLs ────────────────────────────────────────
FRONTEND_URL=http://localhost:3000
BACKEND_URL=http://localhost:8000

# ── Neo4j Knowledge Graph (optional) ───────────
# Used to build file-expert maps and find related past PRs
# Free tier available at https://neo4j.com/cloud/platform/aura-graph-database/
NEO4J_URI=neo4j+s://xxxxxxxx.databases.neo4j.io
NEO4J_USERNAME=neo4j
NEO4J_PASSWORD=

# ── Mem0 Memory Layer (optional) ───────────────
# Used to store project patterns, developer insights, and code review memories
# https://mem0.ai
MEM0_API_KEY=

# ── Feature Flags ───────────────────────────────
# Set to true to run 3 specialized parallel agents (security, performance, style)
# instead of a single agentic review loop. Slower but more thorough.
PARALLEL_REVIEW_AGENTS=false

# ── MCP Integrations (all optional) ────────────
# Pull live context into every PR review from third-party tools.
# Leave blank to skip any integration.

# Linear — linked issues and task descriptions
LINEAR_MCP_URL=
LINEAR_API_KEY=lin_api_...

# Sentry — production errors related to changed files
SENTRY_MCP_URL=
SENTRY_AUTH_TOKEN=

# Slack — relevant channel messages
SLACK_MCP_URL=

# ── Slack Bot (optional) ────────────────────────
# For direct Slack notifications (separate from MCP integration above)
SLACK_BOT_TOKEN=
SLACK_SIGNING_SECRET=

# ── Metorial MCP (optional) ─────────────────────
METORIAL_API_KEY=
GITHUB_MCP_DEPLOYMENT_ID=
