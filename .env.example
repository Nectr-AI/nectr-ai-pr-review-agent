# ═══════════════════════════════════════════════════════════
#  Nectr — AI PR Review Agent  |  .env.example
#  Copy this file to .env and fill in the REQUIRED section.
#  Everything under OPTIONAL can be left blank to skip.
# ═══════════════════════════════════════════════════════════


# ┌─────────────────────────────────────────────────────────┐
# │                      REQUIRED                           │
# │  Must be set for Nectr to start and review PRs.        │
# └─────────────────────────────────────────────────────────┘

# ── AI ──────────────────────────────────────────────────────
# https://console.anthropic.com
ANTHROPIC_API_KEY=sk-ant-...

# ── Database ────────────────────────────────────────────────
# Supabase free tier recommended → https://supabase.com
# Dashboard → Connect → Connection Pooling → Session Mode (port 5432)
DATABASE_URL=postgresql+asyncpg://postgres.<project-id>:<password>@aws-0-<region>.pooler.supabase.com:5432/postgres

# ── GitHub OAuth App ────────────────────────────────────────
# https://github.com/settings/developers → New OAuth App
# Callback URL: https://<your-backend>.up.railway.app/auth/github/callback
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=

# ── GitHub PAT ──────────────────────────────────────────────
# Used to post PR review comments.
# https://github.com/settings/tokens → Classic token → scope: repo
GITHUB_PAT=ghp_...

# ── Auth ────────────────────────────────────────────────────
# Generate: python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=change-this-to-a-random-secret-in-production

# ── URLs ────────────────────────────────────────────────────
BACKEND_URL=http://localhost:8000
FRONTEND_URL=http://localhost:3000   # Next.js dev runs on 3000


# ┌─────────────────────────────────────────────────────────┐
# │                      OPTIONAL                           │
# │  Leave blank to disable. No errors if unset.           │
# └─────────────────────────────────────────────────────────┘

# ── Neo4j Knowledge Graph ───────────────────────────────────
# Enables: file-expert maps, related-PR context in every review.
# Free tier → https://neo4j.com/cloud/platform/aura-graph-database/
NEO4J_URI=
NEO4J_USERNAME=neo4j
NEO4J_PASSWORD=

# ── Mem0 Memory Layer ───────────────────────────────────────
# Enables: per-project patterns and per-developer learned habits.
# https://mem0.ai
MEM0_API_KEY=

# ── MCP Integrations ────────────────────────────────────────
# Pull live context (issues, errors, messages) into every review.
# Each integration is independent — set only the ones you use.

# Linear — linked issues and task descriptions
LINEAR_MCP_URL=
LINEAR_API_KEY=

# Sentry — production errors for files changed in the PR
SENTRY_MCP_URL=
SENTRY_AUTH_TOKEN=

# Slack — relevant channel messages as review context
SLACK_MCP_URL=

# ── Parallel Review Agents ──────────────────────────────────
# true  → 3 specialized agents run in parallel (security / performance / style)
# false → single agentic review loop (default, faster, less token usage)
PARALLEL_REVIEW_AGENTS=false

# ── Slack Bot ───────────────────────────────────────────────
# For direct Slack notifications (separate from the MCP context above)
SLACK_BOT_TOKEN=
SLACK_SIGNING_SECRET=

# ── Webhook Secret (global fallback) ───────────────────────
# Per-repo secrets are stored in the DB automatically on repo connect.
# This is only used as a fallback if no per-repo secret is found.
GITHUB_WEBHOOK_SECRET=

# ── Metorial MCP ────────────────────────────────────────────
METORIAL_API_KEY=
GITHUB_MCP_DEPLOYMENT_ID=


# ┌─────────────────────────────────────────────────────────┐
# │                   APP SETTINGS                          │
# │  Safe to leave as-is for local development.            │
# └─────────────────────────────────────────────────────────┘

APP_NAME=Nectr
APP_ENV=development
DEBUG=True
LOG_LEVEL=DEBUG
HOST=0.0.0.0
PORT=8000
ACCESS_TOKEN_EXPIRE_MINUTES=1440
ALGORITHM=HS256
ANTHROPIC_MODEL=claude-sonnet-4-5-20250929
